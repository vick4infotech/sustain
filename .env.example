# Copy to .env.local for local development.

# --- Database ---
# Local default is ./.data/sustain.db
# On Vercel, only /tmp is writable. We default to /tmp/sustain.db when VERCEL=1.
DATABASE_PATH=.data/sustain.db

# --- Sessions ---
# Required for production. If missing in local dev, an ephemeral secret is generated.
SESSION_SECRET=replace-me-with-a-long-random-string
SESSION_COOKIE_NAME=sid
SESSION_TTL_HOURS=168

# --- Talent self-signup control ---
# If set, talents must provide this code during signup.
PROGRAMME_ACCESS_CODE=

# --- Admin bootstrap (optional) ---
# If no admin exists, the first request will create one using these values.
# Do NOT commit real values.
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=

# --- File storage ---
# Local dev will create ./storage/uploads
# Vercel uses /tmp/uploads (ephemeral)
UPLOADS_DIR=storage/uploads

# --- Operational ---
APP_NAME=SUSTAIN Platform (MVP)
